    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="searchIslModalLabel">Ricerca ISL</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
			<div class="modal-body" id="search-isl-body">
				<div id="isl-filters">
					<div>
						<input type="text" placeholder="ISL-0000-0000" id="isl-search-input" class="form-control text-dark">
						<button type="button" id="submit-research" class="btn btn-primary ms-2">Ricerca</button>
					</div>
					<div class="mt-2">
						<div class="form-check p-0">
							<label class="form-check-label" for="isl-checkbox-close">CLOSE</label>
							<input class="form-check-input ms-2" type="checkbox" name="isl-checkbox-close" id="isl-checkbox-close">
						</div>
						<div class="form-check p-0">
							<label class="form-check-label" for="isl-checkbox-sosp">SOSP</label>
							<input class="form-check-input ms-2" type="checkbox" name="isl-checkbox-sosp" id="isl-checkbox-sosp">
						</div>
						<div class="form-check p-0">
							<label class="form-check-label" for="isl-checkbox-svil">SVIL</label>
							<input class="form-check-input ms-2" type="checkbox" name="isl-checkbox-svil" id="isl-checkbox-svil" checked="true">
						</div>
						<div class="form-check p-0">
							<label class="form-check-label" for="isl-checkbox-deli">DELI</label>
							<input class="form-check-input ms-2" type="checkbox" name="isl-checkbox-deli" id="isl-checkbox-deli">
						</div>
						<div class="form-check p-0">
							<label class="form-check-label" for="isl-checkbox-anfu">ANFU</label>
							<input class="form-check-input ms-2" type="checkbox" name="isl-checkbox-anfu" id="isl-checkbox-anfu" checked="true">
						</div>
						<div class="form-check p-0">
							<label class="form-check-label" for="isl-checkbox-new">NEW</label>
							<input class="form-check-input ms-2" type="checkbox" name="isl-checkbox-new" id="isl-checkbox-new">
						</div>
					</div>
				</div>
				<div id="search-table-container">
					<table class="table table-striped" id="search-isl-table">
						<thead>
							<tr>
								<th scope="col"><div>ISL</div></th>
								<th scope="col"><div>Stato</div></th>
								<th scope="col"><div>Ragione Sociale</div></th>
								<th scope="col"><div>Descrizione</div></th>
							</tr>
						</thead>
						<tbody id="isl-tbody">                
								
							<tr class="search-isl-riga">
								<td id="rifCli">ISL-0108-0341</td>
								<td id="stato">1010 - Anal.Funz</td>
								<td id="acliRagSoc1">Sata Consulting S.r.l.</td>
								<td id="tatvDesc"><p>Censita casistica per valutare se e come intervenire:le start/end manodopera vengono consentite su una fase ciclo con CdL tipo macchina solo se è stata effettuata una start su una risorsa macchina. La registrazione manodopera è agganciata a quella della risorsa macchina (principale) impostando c_addetto (manodopera) = c_ris (macchina). c_addetto non risulta tuttavia corretto se la fase ciclo ha si un CdL di tipo macchina ma ha come ris.dominate (sulla fase ciclo) la manodopera. (L'esistenza di un tipo risorsa dominante sulla fase ciclo non allineato a quello del CdL/operazione ha genera criticità; visto anche quanto sopra, si potrebbe valutare una soluzione per gestire correttamente l'allineamento dei dati sulle fasi-ciclo)</p></td>
							</tr>

						</tbody>
					</table>
				</div>
			</div>
			<div class="modal-footer d-flex justify-content-between">
				<div id="n-tot-isl"></div>
				<div>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
					<button type="submit" id="submit-isl-button" class="btn btn-primary" data-bs-dismiss="modal">Seleziona</button>
				</div>
			</div>
        </div>
    </div>
</div>

@section scripts{
	<script src="~/js/generic.js"></script>
	<script src="~/js/Crrg.js"></script>
	<script src="~/js/isl.js"></script>
	@if (daTeamwork)
	{
		var giorno = Model.CrrgDtt.ToString("yyyy-MM-dd");
		var datiTeamwork = new
		{
			timelogId = Model.TwTimelogId,
			taskId = Model.TwTaskId,
			urlTask = Model.TwTaskId is long taskId ? _twOptions.Value.UrlTask(taskId) : null,
			urlImporta = Url.Action("Registrazioni", "Teamwork", new { dal = giorno, al = giorno })
		};
		<style>
			/* [231009] Campi di un consuntivo importato da Teamwork: non modificabili. Sono readonly (il valore va inviato),
			   ma con l'aspetto dei campi disabilitati del tema (SataTheme.css, .form-control:disabled): Bootstrap renderebbe
			   i readonly più chiari dei campi normali */
			.form-control.tw-bloccato { pointer-events: none; color: #fdf6e3; background-color: #839496; opacity: 1; }
			.tw-lucchetto { color: inherit; opacity: .75; line-height: 1; vertical-align: baseline; }
			.tw-lucchetto:hover, .tw-lucchetto:focus { opacity: 1; }
		</style>
		@* System.Text.Json escapa <, > e & : sicuro dentro <script> *@
		<script>window.twCollegamento = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(datiTeamwork));</script>
		<script>
			// [231009] Consuntivo importato da Teamwork: risorsa, data, tempo e commessa/ISL in sola lettura.
			// readonly (e non disabled) perché i valori devono comunque arrivare al server con il salvataggio.
			// Accanto all'etichetta di ogni campo bloccato un lucchetto: al clic, popover con il motivo e i collegamenti.
			(function () {
				var tw = window.twCollegamento;
				if (!tw) return;

				function esc(s) {
					var span = document.createElement('span');
					span.textContent = s == null ? '' : String(s);
					return span.innerHTML;
				}

				// Unico pulsante: il task su Teamwork; la pagina Importa da Teamwork è un link nel testo
				var collegamenti = tw.urlTask
					? '<div class="mt-2"><a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" href="' + esc(tw.urlTask) + '">' +
					  '<i class="bi bi-box-arrow-up-right me-1"></i>Apri il task su Teamwork</a></div>'
					: '';
				var linkImporta = '<a href="' + esc(tw.urlImporta) + '">Importa da Teamwork</a>';
				var comeCorreggere = ' Per correggere il valore modifica la registrazione su Teamwork e poi allinea dalla pagina ' + linkImporta + '.';

				var campi = [
					{ el: document.getElementById('input-risorsa'), testo: 'La risorsa è chi ha registrato il tempo su Teamwork.' },
					{ el: document.querySelector('input[name="CrrgDtt"]'), testo: 'La data arriva dalla registrazione su Teamwork.' },
					{ el: document.getElementById('CrrgTmRunIncrHMS'), testo: 'Il tempo arriva dalla registrazione su Teamwork.' },
					{ el: document.getElementById('CrrgRifCliente'), testo: "L'ISL arriva dal campo Commessa/ISL del task su Teamwork." },
					{ el: document.getElementById('CliDropdownInput'), testo: 'Il cliente è quello della commessa indicata nel task su Teamwork.' },
					{ el: document.getElementById('ComDropdownInput'), testo: 'La commessa arriva dal campo Commessa/ISL del task su Teamwork.' }
				];
				// Etichetta del campo: il primo .form-group antenato che ne contiene una (cliente e commessa
				// stanno in un .form-group interno, senza etichetta, dentro quello che la contiene)
				function etichettaDi(el) {
					for (var g = el.closest('.form-group'); g; g = g.parentElement ? g.parentElement.closest('.form-group') : null) {
						var l = g.querySelector('label');
						if (l) return l;
					}
					return null;
				}
				campi.forEach(function (c) {
					if (!c.el) return;
					c.el.readOnly = true;
					c.el.tabIndex = -1;
					c.el.classList.add('tw-bloccato');
					var etichetta = etichettaDi(c.el);
					if (!etichetta || etichetta.querySelector('.tw-lucchetto')) return;
					var lucchetto = document.createElement('button');
					lucchetto.type = 'button';
					lucchetto.className = 'btn btn-link p-0 ms-1 tw-lucchetto tw-popover';
					lucchetto.setAttribute('aria-label', 'Campo non modificabile: perché');
					lucchetto.dataset.twTesto = c.testo;
					lucchetto.innerHTML = '<i class="bi bi-lock-fill"></i>';
					etichetta.appendChild(lucchetto);
				});
				document.querySelectorAll('input[name="modalita"]').forEach(function (r) { r.disabled = true; });
				document.querySelectorAll('button[onclick^="setupSearchIsl"]').forEach(function (b) { b.disabled = true; });

				// ------------------------------------------------ popover (uno alla volta, chiusura con clic fuori o Esc)
				var aperto = null;
				function chiudi() {
					if (!aperto) return;
					var p = bootstrap.Popover.getInstance(aperto);
					if (p) p.dispose();
					aperto = null;
				}
				function apri(el) {
					var chip = el.id === 'tw-chip';
					var titolo = chip ? 'Consuntivo importato da Teamwork' : 'Non modificabile';
					var corpo = chip
						? 'Registrazione Teamwork <strong>' + esc(tw.timelogId) + '</strong>' + (tw.taskId ? ' del task <strong>#' + esc(tw.taskId) + '</strong>' : '') + '.<br>' +
						  'Qui modifichi operazione, causale, macroattività, applicativo, modulo e note. ' +
						  'Risorsa, data, tempo e commessa/ISL si correggono su Teamwork e arrivano con l\'allineamento dalla pagina ' + linkImporta + '.'
						: esc(el.dataset.twTesto) + comeCorreggere;
					new bootstrap.Popover(el, {
						trigger: 'manual', placement: chip ? 'bottom' : 'top', html: true,
						sanitize: false, // contenuto costruito qui, con i soli valori escapati
						title: titolo, content: '<div>' + corpo + '</div>' + collegamenti
					}).show();
					aperto = el;
				}
				document.addEventListener('click', function (ev) {
					var el = ev.target.closest('.tw-popover');
					if (el) {
						var stesso = el === aperto;
						chiudi();
						if (!stesso) apri(el);
						return;
					}
					if (aperto && !ev.target.closest('.popover')) chiudi();
				});
				document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape') chiudi(); });
			})();
		</script>
	}

}



