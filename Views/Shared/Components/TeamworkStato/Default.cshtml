@model bool
@* [231009] Voce Teamwork nella dropdown utente: true = account Teamwork collegato.
   Icona: simbolo ufficiale Teamwork (pacchetto "teamwork-symbol.zip" della pagina https://www.teamwork.com/brand/,
   file RGB/SVG/teamwork-short-circle-slate-pink-dot-icon.svg, già tondo: non va ritagliato). *@
<li>
    <a class="dropdown-item d-flex align-items-center gap-2"
       asp-area="" asp-controller="Teamwork" asp-action="Index"
       title="@(Model ? "Account Teamwork collegato" : "Account Teamwork non collegato: clicca per collegarlo")">
        <img src="~/img/teamwork-symbol.svg" alt="" width="24" height="24" style="width:24px;height:24px;flex:none;" />
        <span>Teamwork</span>
        <span class="badge rounded-pill @(Model ? "text-bg-success" : "text-bg-secondary") ms-auto">@(Model ? "collegato" : "scollegato")</span>
    </a>
</li>
<li><hr class="dropdown-divider" /></li>
