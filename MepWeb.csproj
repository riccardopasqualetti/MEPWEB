<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Versione assembly -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <Version>1.0.0</Version>

    <!-- Migliora metadati e riproducibilità -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

    <!-- Disabilita generazione automatica di InformationalVersion -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <UserSecretsId>931a60fe-1128-4834-a1a7-b2cd37c552a9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
    <!-- Usato direttamente dal codice: prima arrivava solo come dipendenza transitiva -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Microsoft.Data.SqlClient porta la 9.0.x, con vulnerabilità note (GHSA-846f-f764-76mx) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Target per aggiungere hash commit e data all'assembly -->
  <Target Name="SetInformationalVersion"
      AfterTargets="InitializeSourceControlInformation"
      BeforeTargets="CoreCompile">

    <Exec Command='git log -1 --pretty=format:%%cI'
        WorkingDirectory="$(MSBuildProjectDirectory)"
        ConsoleToMSBuild="true"
        IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="CommitDateRaw" />
    </Exec>

    <PropertyGroup>
      <CommitDate>$([System.String]::Copy('$(CommitDateRaw)').Trim())</CommitDate>
      <CommitDate Condition="'$(CommitDate)'==''">unknown</CommitDate>
      <InformationalVersion>$(Version)+$(SourceRevisionId);date=$(CommitDate)</InformationalVersion>
    </PropertyGroup>

    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(InformationalVersion)</_Parameter1>
      </AssemblyAttribute>

      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>CommitDate</_Parameter1>
        <_Parameter2>$(CommitDate)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>

    <Message Importance="High" Text="[$(MSBuildProjectName)] INFO='$(InformationalVersion)'" />
  </Target>

</Project>
